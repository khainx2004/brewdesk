# Copy file này thành .env rồi điền giá trị thật. File .env KHÔNG được commit.

# PostgreSQL
POSTGRES_DB=brewdesk
POSTGRES_USER=brewdesk_user
POSTGRES_PASSWORD=doi-mat-khau-nay

# Backend (DEV — backend chạy ngoài container, nối tới DB ở localhost).
# PROD (docker-compose.prod.yml) tự đặt DB_URL trỏ tới service "postgres", bỏ qua 3 dòng này.
DB_URL=jdbc:postgresql://localhost:5432/brewdesk
DB_USER=brewdesk_user
DB_PASSWORD=doi-mat-khau-nay

# JWT — bắt buộc, tối thiểu 32 ký tự.
# Sinh chuỗi ngẫu nhiên: openssl rand -base64 48
JWT_SECRET=sinh-chuoi-ngau-nhien-toi-thieu-32-ky-tu-va-giu-bi-mat

# PROD/VPS — HTTPS tự động (Caddy + Let's Encrypt). Bắt buộc cho bản VPS.
# DOMAIN phải có DNS A record trỏ về IP của VPS; mở cổng 80 + 443.
DOMAIN=quan.example.com
ACME_EMAIL=ban@example.com

# Chỉ dùng cho bản LAN (bỏ Caddy, mở cổng cho web). Bản VPS bỏ qua.
WEB_PORT=80
